+    elif (( rc == 1 )); then _p_emit LIN-LOG-AUDITD WARN "auditd not active"
+    else _p_emit LIN-LOG-AUDITD NA "service state unknown"; fi
+
+    fw="$(_p_any_svc rsyslog syslog-ng syslog)"; rc=$?
