+    envpath="$(awk -F= '$1=="PATH" {gsub(/"/,"",$2); print $2; exit}' "$R/etc/environment" 2>/dev/null)"
+    [[ -n "$envpath" ]] && pathlist="$pathlist:$envpath"
+    bad=""
+    local seen=""
+    local IFS_SAVE="$IFS"
+    IFS=:
