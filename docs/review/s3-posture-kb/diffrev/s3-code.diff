+    elif [[ -e "$R/etc/crontab" || -d "$R/etc/cron.d" ]]; then _p_emit LIN-CRON-PERMS PASS "cron paths not world-writable"
+    else _p_emit LIN-CRON-PERMS NA "no system cron configuration"; fi
+
+    # --- logging / time ----------------------------------------------------------------
