+            case "$v" in
+                *enabled*) _p_emit LIN-BOOT-SECUREBOOT PASS "SecureBoot enabled (mokutil)" ;;
+                *disabled*) _p_emit LIN-BOOT-SECUREBOOT WARN "SecureBoot disabled (mokutil)" ;;
+                *) _p_emit LIN-BOOT-SECUREBOOT ERR "mokutil output unrecognised" ;;
